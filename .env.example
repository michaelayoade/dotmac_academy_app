# App connection — uses app_user role, RLS-enforced
DATABASE_URL=postgresql+psycopg://app_user:app_user@localhost:5437/academy

# Restricted single-Academy settings writer (historical role name: platform_api)
PLATFORM_DATABASE_URL=postgresql+psycopg://platform_api:platform_api@localhost:5437/academy

# Migration connection — may use the schema owner/superuser; never used by a
# continuous application worker.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:academy_super@localhost:5437/academy

# Lab-host only: continuous worker/reconciler uses a dedicated non-owning DSN,
# never postgres. Leave empty on the web host so it cannot acquire this role.
LAB_WORKER_DATABASE_URL=

# Single-Academy routing. Both are required in production. TENANCY names the
# topology only; the kernel binds the sole tenant identity from the database.
PLATFORM_ROOT_DOMAIN=localhost
TENANCY=single

# Required in production: hosts allowed by TrustedHostMiddleware
# In dev with subdomain.localhost, leave empty.
TRUSTED_HOSTS=

# JWT auth
JWT_SECRET=dev-insecure-change-me
SESSION_HASH_SECRET=dev-insecure-change-me
JWT_TTL_SECONDS=3600

# Account password reset only. Positive integer; DB setting overrides this
# environment default. Preserves the historical reset minimum of 8 characters.
PASSWORD_RESET_MIN_LENGTH=8
# Password-reset token lifetime; DB settings can override this value.
PASSWORD_RESET_TOKEN_MINUTES=120

# Browser/API guardrails
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000
TRUST_INBOUND_REQUEST_ID=false
SECURITY_HEADERS_ENABLED=true
# Empty uses Academy's product CSP (inline scripts + same-origin WebSockets).
CONTENT_SECURITY_POLICY=

# ERP applicant assessment integration. Keep the two HMAC secrets distinct.
ERP_INBOUND_HMAC_SECRET=
ERP_ASSESSMENT_TOKEN_SECRET=
ERP_INBOUND_HMAC_MAX_SKEW_SECONDS=300
ERP_ALLOWED_RETURN_ORIGINS=
ACADEMY_PUBLIC_BASE_URL=

# Lab consoles. Two DIFFERENT addresses whenever the lab worker runs on its own
# host: LAB_CONSOLE_HOST is what the app DIALS (the worker's tunnel address, e.g.
# its WireGuard IP), LAB_CONSOLE_BIND_HOST is what ttyd BINDS locally. Setting a
# remote address as the bind host leaks ttyd processes that spin at 100% CPU on
# an impossible bind — the app refuses to spawn them, but only if this is right.
# Empty bind host means "same as LAB_CONSOLE_HOST" (correct on a single host).
# Fail closed: use `web` on every non-lab host. Only the dedicated academy-labs
# worker host may set this to `lab`.
LAB_HOST_ROLE=web
MAX_CONCURRENT_LABS_PER_TENANT=0
LAB_CONSOLE_HOST=127.0.0.1
LAB_CONSOLE_BIND_HOST=

# Existing Academy -> ERP completion webhook.
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=

# SMTP is inert when SMTP_HOST is empty. Configure values through environment
# or the authenticated Academy settings page; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Dotmac Academy <academy@localhost>
SMTP_STARTTLS=true

ENVIRONMENT=dev


# Invitation cohort role policy (DB platform_settings overrides these defaults).
# JSON object of global-role names to student/instructor; unknown roles use the
# configured default. These defaults preserve the existing invitation behavior.
INVITATION_MEMBER_ROLE_MAP='{"admin":"instructor","instructor":"instructor"}'
INVITATION_DEFAULT_MEMBER_ROLE=student

# Web chosen-password account creation policy only (DB platform_settings wins).
# Target role -> ordered nonempty unique list of admitted actor role slugs.
WEB_ACCOUNT_CREATION_ROLE_ADMISSION='{"student":["instructor","admin"],"instructor":["admin"],"admin":["admin"]}'
# Zero preserves this entrypoint's existing absence of a password strength minimum.
# Required HTTP Form handling remains separate; reset PASSWORD_RESET_MIN_LENGTH is independent.
WEB_ACCOUNT_CREATION_PASSWORD_MIN_LENGTH=0

# All configured missing roles are provisioned with these exact names, independently
# of admission. Empty {} disables role creation; actual role refs must still resolve.
WEB_ACCOUNT_CREATION_ROLE_PROVISIONING='{"student":"Student","instructor":"Instructor","admin":"Administrator"}'

# Learning policy: product compatibility defaults; DB overrides remain authoritative.
LEARNING_READING_WORDS_PER_MINUTE=200
LEARNING_READING_MINIMUM_MINUTES=1
LEARNING_JOIN_LEAD_MINUTES=60
LEARNING_TODO_GRADED_LOOKBACK_DAYS=14
LEARNING_TODO_GRADED_LIMIT=10
LEARNING_TODO_WINDOW_HORIZON_DAYS=30
LEARNING_TODO_NEAR_DEADLINE_DAYS=7
LEARNING_TODO_FAR_DEADLINE_DAYS=30
LEARNING_AGENDA_LIMIT=50
LEARNING_PERSON_ANNOUNCEMENTS_LIMIT=20
LEARNING_TENANT_ANNOUNCEMENTS_LIMIT=50
LEARNING_DASHBOARD_AT_RISK_FRACTION=0.5
LEARNING_DASHBOARD_STALE_DAYS=14
LEARNING_BEHIND_PACE_FRACTION=0.2
LEARNING_SEARCH_LIMIT=20
# JSON role list; [] disables staff search access.
LEARNING_SEARCH_STAFF_ROLES=["instructor","admin"]
LEARNING_TOP_MOVERS_LIMIT=5
LEARNING_ATTENTION_LIMIT=8
LEARNING_INSTRUCTOR_AT_RISK_FRACTION=0.5
LEARNING_INSTRUCTOR_STALE_DAYS=14
LEARNING_INSTRUCTOR_WORKSPACE_LIMIT=12
LEARNING_TREND_SAMPLE_LIMIT=10
LEARNING_TREND_MIN_SAMPLES=4
LEARNING_TREND_MIN_DELTA_FRACTION=0.05
LEARNING_ACTIVITY_CHART_WEEKS=8
LEARNING_VELOCITY_WEEKS=4
LEARNING_RESUME_AFTER_DAYS=7
LEARNING_ACTIVE_WINDOW_DAYS=7
LEARNING_COMPARISON_PRIOR_WEEKS=4
SUCCESS_INACTIVE_DAYS=7
SUCCESS_MIN_GRADE_PCT=60
SUCCESS_CERTIFICATE_GRACE_HOURS=6
SUCCESS_INACTIVITY_HIGH_FACTOR=2.0
SUCCESS_OVERDUE_HIGH_COUNT=3
SUCCESS_OVERDUE_HIGH_DAYS=7
SUCCESS_OVERDUE_TITLE_LIMIT=5
SUCCESS_BELOW_PASSING_MIN_GRADED=2
SUCCESS_BELOW_PASSING_MIN_WEIGHT_FRACTION=0.2
SUCCESS_BELOW_PASSING_HIGH_GRADE_FACTOR=0.5
SUCCESS_ALMOST_COMPLETE_FRACTION=0.8
LEARNING_DEFAULT_ACTIVITY_TYPE=mcq_test
LEARNING_DEFAULT_ACTIVITY_PASS_THRESHOLD=0.0
LEARNING_DEFAULT_ACTIVITY_ASSESSMENT_MODE=graded
LEARNING_DEFAULT_ACTIVITY_GRADING=auto
LEARNING_DEFAULT_ACTIVITY_WEIGHT=1.0
LEARNING_DEFAULT_COURSE_STATUS=published
LEARNING_DEFAULT_COURSE_LISTED=false
LEARNING_DEFAULT_SESSION_TYPE=live_class
LEARNING_DEFAULT_EXTRA_ATTEMPTS=1
LEARNING_BANK_PASS_THRESHOLD_BY_KIND={"chapter":0.0,"mid":0.6,"final":0.7}
LEARNING_BANK_FALLBACK_PASS_THRESHOLD=0.0
LEARNING_BANK_NEW_ACTIVITY_ASSESSMENT_MODE=graded
LEARNING_BANK_NEW_ACTIVITY_GRADING=auto
LEARNING_BANK_NEW_ACTIVITY_WEIGHT=1.0
LEARNING_EXAM_SECONDS_PER_QUESTION=12.0
LEARNING_EXAM_NEAR_CHANCE_MARGIN=1.33
LEARNING_EXAM_FALLBACK_SCORE_FLOOR=0.3333333333333333
LEARNING_EXAM_FALLBACK_DURATION_SECONDS=360.0
LEARNING_MISSING_QUESTION_WEIGHT=1

# Report window and new-lab fallback policy. Explicit persisted values retain their meaning.
LEARNING_ACTIVITY_REPORT_HOURS=24
LEARNING_LAB_PASS_THRESHOLD=0.7

# Canonical sign-in product lockout policy (DB overrides are strict).
AUTHENTICATION_MAX_FAILED_LOGINS=5
AUTHENTICATION_LOCKOUT_MINUTES=15

# Self-profile upload bound and missing-key email preference defaults.
# These preferences do not enable global email delivery.
ACCOUNT_AVATAR_MAX_BYTES=1048576
ACCOUNT_EMAIL_RESULTS_DEFAULT=true
ACCOUNT_EMAIL_DIGEST_DEFAULT=true

# Self-service password-change purpose minimum; separate from reset/creation.
# Zero deliberately removes this purpose's minimum when explicitly configured.
PASSWORD_CHANGE_MIN_LENGTH=8

# Entrance-assessment invitation validity; positive whole days, overridden by Settings store.
ENTRANCE_INVITATION_DEADLINE_DAYS=7

# Invitation issuance/acceptance purposes; expiry is native timedelta hours.
INVITATION_TOKEN_HOURS=168
INVITATION_PASSWORD_MIN_LENGTH=8
INVITATION_HUMAN_REPLACE_OUTSTANDING=true
# Prepared stranded-purpose policy only; its existing caller remains unported.
INVITATION_STRANDED_REPLACE_OUTSTANDING=false

# New canonical account state (DB settings override these environment defaults).
ACCOUNT_INITIAL_IS_ACTIVE=true
ACCOUNT_INITIAL_PROFILE_STATUS=active

# Automatic onboarding enrollment and additive task seed policy.
ADMISSION_ENROLLMENT_INITIAL_ROLE=student
ADMISSION_ENROLLMENT_INITIAL_STATUS=active
ONBOARDING_ENROLLMENT_GLOBAL_ROLE=student
INVITATION_ONBOARDING_REPLACE_OUTSTANDING=true
ONBOARDING_TASK_CATALOG=[["entrance_assessment","Complete the entrance assessment"],["confirm_details","Confirm your enrolment details"],["orientation","Review the programme orientation"]]

# New-row enrollment facts; exact strings of at most 20 characters.
BULK_ENROLLMENT_INITIAL_ROLE=student
BULK_ENROLLMENT_INITIAL_STATUS=active
INVITATION_ENROLLMENT_INITIAL_STATUS=active

# Required exact server identities for migration entry; empty denies migrations.
MIGRATION_LOGIN_ROLE=
MIGRATION_EFFECTIVE_ROLE=

# Offline tenant-bootstrap role admission: explicit [login,effective] pairs.
# Empty denies every database role; no privileged fallback is inferred.
BOOTSTRAP_ALLOWED_DATABASE_ROLE_PAIRS=[]
BOOTSTRAP_ROLE_PROVISIONING={"student":"Student","instructor":"Instructor","admin":"Administrator"}
BOOTSTRAP_INITIAL_ROLE_SLUG=admin
BOOTSTRAP_TENANT_IS_ACTIVE=true
BOOTSTRAP_PASSWORD_MIN_LENGTH=0
BOOTSTRAP_OWNER_FIRST_NAME=Admin
BOOTSTRAP_OWNER_LAST_NAME_TEMPLATE={tenant_name}
# ACCOUNT_INITIAL_IS_ACTIVE and ACCOUNT_INITIAL_PROFILE_STATUS apply here too.

# Academy notification center: positive count, DB override uses the same decoder.
NOTIFICATIONS_RECENT_LIMIT=30

# Settings portal role policy. Custom tenant role slugs accepted; [] denies everyone.
SETTINGS_ACCESS_ROLES=["admin"]

# Process policy: finite positive seconds; changes invalidate the matching cache.
METRICS_LAB_PROBE_TTL_SECONDS=30.0
METRICS_LAB_PROBE_TIMEOUT_SECONDS=2.0
METRICS_PIPELINE_TTL_SECONDS=60.0

# Calendar token lifetime, stable event UID namespace and download filename.
ICAL_FEED_TOKEN_TTL_DAYS=365
ICAL_FEED_UID_DOMAIN=academy.dotmac.io
ICAL_FEED_FILENAME=dotmac-academy.ics

# Teaching home access; JSON role list, empty denies all access.
TEACHING_ACCESS_ROLES=["instructor","admin"]

# Catalog preview and gradebook role policy; empty lists deny.
CATALOG_STAFF_ROLES=["instructor","admin"]
GRADEBOOK_ACCESS_ROLES=["instructor","admin"]

# Report portal role policy; [] denies all; independent from Settings/search.
REPORTS_ACCESS_ROLES=["instructor","admin"]

# Learner lab-check output excerpts; positive integers, empty values refused.
LAB_CHECK_EVIDENCE_CHARS=160
LAB_CHECK_DNS_ACTUAL_CHARS=120

# Independent admin surface access roles (JSON arrays; [] denies access).
# Defaults are declared solely by Settings. Custom role slugs are accepted.
# ADMIN_HOME_ACCESS_ROLES=[]
# LAB_ADMIN_ACCESS_ROLES=[]
# REMINDERS_ADMIN_ACCESS_ROLES=[]
