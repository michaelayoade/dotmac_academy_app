# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/

# Virtual envs
.venv/
venv/
# .env and anything derived from it. The bare `.env` rule left backups like
# `.env.bak-glitchtip-20260730-101507` untracked but committable, so a single
# `git add -A` on a deploy host would have committed live credentials.
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/
*.swp

# Node / Tailwind build (the compiled static/app.css IS committed)
node_modules/

# OS
.DS_Store

# Worktrees
.worktrees/

# Figures synced from dotmac-academy at import time (derived assets)
static/figures/

# User-uploaded avatars (runtime data, not source)
static/avatars/

# Prod-local secrets / data — must never be committed (rescued 2026-07-11)
.pgsecret.env
.tenant-admin-pw
*-admin-pw
enrolled_students_progress.csv
*_progress.csv
